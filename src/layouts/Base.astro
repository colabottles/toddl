---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 5);

interface Props {
  title: string;
  description?: string;
  image?: string;
  standardSiteUri?: string;
}

const {
  title,
  description = "Developer and accessibility advocate based in Phoenix, AZ.",
  image,
  standardSiteUri,
} = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#252C37" />
    <link
      rel="site.standard.publication"
      href="at://did:plc:gevyqibw5p2xsonkbsbjm5vy/site.standard.publication/3mnqgth7gxo2f"
    />
    {
      standardSiteUri && (
        <link rel="site.standard.document" href={standardSiteUri} />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title + " · Todd Libby"} />
    <meta property="og:description" content={description} />
    <meta
      property="og:url"
      content={`https://toddl.dev${Astro.url.pathname}`}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content={image ??
        "https://res.cloudinary.com/colabottles/image/upload/v1731376889/todd-social-card-names.png"}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title + " · Todd Libby"} />
    <meta name="twitter:description" content={description} />
    <title>{title} · Todd Libby</title>
    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;
      const theme = stored ?? (prefersDark ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    <header>
      <a href="#main-content" class="skip-link">skip to main content</a>
    </header>

    <aside class="sidebar" id="sidebar" aria-label="Site navigation">
      <button
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch to light mode"
      >
        <svg
          role="img"
          class="icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          focusable="false"
        >
          <title>Switch to light mode</title>
          <circle cx="12" cy="12" r="4"></circle>
          <line x1="12" y1="2" x2="12" y2="4"></line>
          <line x1="12" y1="20" x2="12" y2="22"></line>
          <line x1="4.93" y1="4.93" x2="6.34" y2="6.34"></line>
          <line x1="17.66" y1="17.66" x2="19.07" y2="19.07"></line>
          <line x1="2" y1="12" x2="4" y2="12"></line>
          <line x1="20" y1="12" x2="22" y2="12"></line>
          <line x1="4.93" y1="19.07" x2="6.34" y2="17.66"></line>
          <line x1="17.66" y1="6.34" x2="19.07" y2="4.93"></line>
        </svg>
        <svg
          role="img"
          class="icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          focusable="false"
        >
          <title>Switch to dark mode</title>
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <div>
        <p class="sidebar__prompt">~/toddl $</p>
        <p class="sidebar__name">Todd Libby</p>
        <p class="sidebar__role">Web Developer</p>
      </div>

      <Nav currentPath={currentPath} />

      <section class="webring" aria-labelledby="webring-heading">
        <h2 id="webring-heading" class="webring__title">a11y-webring.club</h2>
        <p class="webring__desc">
          This site is a member of the <a
            href="https://a11y-webring.club/"
            class="webring__link"
            target="_blank"
            rel="noopener noreferrer">a11y-webring.club</a
          >.
        </p>
        <nav aria-label="a11y webring navigation">
          <ul class="webring__links">
            <li>
              <a
                href="https://a11y-webring.club/prev"
                class="webring__link"
                rel="external">Previous</a
              >
            </li>
            <li>
              <a
                href="https://a11y-webring.club/random"
                class="webring__link"
                rel="external">Random</a
              >
            </li>
            <li>
              <a
                href="https://a11y-webring.club/next"
                class="webring__link"
                rel="external">Next</a
              >
            </li>
          </ul>
        </nav>
      </section>

      <section class="stack" aria-labelledby="stack-heading">
        <h2 id="stack-heading" class="stack__label">stack</h2>
        <ul class="stack__chips">
          {
            ["Nuxt 4", "TypeScript"].map((s) => (
              <li>
                <span class="chip chip--hi">{s}</span>
              </li>
            ))
          }
          {
            ["Supabase", "Netlify", "Astro", "WCAG 2.2", "Node"].map((s) => (
              <li>
                <span class="chip">{s}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>

    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <button
      class="hamburger"
      id="hamburger"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="sidebar"
    >
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
    </button>

    <div class="layout" id="layout">
      <main class="main" id="main-content" tabindex="-1">
        <slot />
      </main>

      <aside
        class="right-panel"
        id="right-panel"
        aria-label="Support"
      >
        <div class="right-panel__top">
          <button
            class="cb-toggle"
            id="cb-toggle"
            aria-label="Open Codeberg panel"
            aria-expanded="false"
            aria-controls="cb-panel"
          >
            <svg
              role="img"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              focusable="false"
            >
              <title>Codeberg</title>
              <polyline points="7 8 3 12 7 16"></polyline>
              <polyline points="17 8 21 12 17 16"></polyline>
              <line x1="14" y1="4" x2="10" y2="20"></line>
            </svg>
          </button>
        </div>

        <section
          class="support-panel"
          id="support-panel"
          aria-labelledby="sponsor-heading"
        >
          <h2 id="sponsor-heading" class="support-panel__title">
            support my work
          </h2>
          <p class="support-panel__pitch">
            I build accessible, open-source tools and write about web
            accessibility. If my work has helped you, consider sponsoring or
            advertising here.
          </p>
          <ul class="support-panel__links">
            <li>
              <a
                href="https://liberapay.com/colabottles/"
                class="support-link support-link--liberapay"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <path d="M20.42 4.58a5.4 5.4 0 0 0-7.65 0l-.77.78-.77-.78a5.4 5.4 0 0 0-7.65 0C1.46 6.7 1.33 10.28 4 13l8 8 8-8c2.67-2.72 2.54-6.3.42-8.42z"></path>
                </svg>
                Liberapay
              </a>
            </li>
            <li>
              <a
                href="https://ko-fi.com/Y8Y727FD2"
                class="support-link support-link--kofi"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  focusable="false"
                >
                  <path
                    d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.483-2.566 2.483-2.566s-.016-1.682.104-3.937c.148-3.053 1.547-3.513 1.547-3.513h1.585c1.995 0 3.357 1.106 3.357 3.357 0 1.784-1.32 2.748-2.89 2.748H20.29c-.708 0-1.027.607-1.027 1.152 0 .803.645 1.229 1.027 1.229h.938c2.527 0 5.009-1.47 5.009-4.613a5.058 5.058 0 0 0-2.366-4.266zM5.393 14.5H3.107V7h2.286v7.5zm5.357 0H8.464V7h2.286v7.5z"
                  ></path>
                </svg>
                Ko-fi
              </a>
            </li>
            <li>
              <a href="/contact" class="support-link support-link--ad"
                >advertise here</a
              >
            </li>
          </ul>
        </section>

        <section class="recent-posts" aria-labelledby="recent-posts-heading">
          <h2 id="recent-posts-heading" class="recent-posts__title">
            recent posts
          </h2>
          <ul class="recent-posts__list">
            {
              recentPosts.map((post) => (
                <li class="recent-post">
                  <a href={`/blog/${post.id}`} class="recent-post__link">
                    <span class="recent-post__title">{post.data.title}</span>
                    <span class="recent-post__date">
                      {new Date(post.data.date).toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </span>
                    {post.data.bskyPostId && (
                      <span
                        class="recent-post__likes"
                        data-bsky-id={post.data.bskyPostId}
                      >
                        🦋 —
                      </span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <aside
          class="cb-panel"
          id="cb-panel"
          aria-label="Codeberg profile"
          aria-hidden="true"
        >
          <header class="cb-panel__header">
            <h2 class="cb-panel__title">Codeberg</h2>
            <button
              class="cb-panel__close"
              id="cb-close"
              aria-label="Close Codeberg panel"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                focusable="false"
              >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </header>
          <div class="cb-panel__body" id="cb-body">
            <p class="cb-loading">Loading...</p>
          </div>
        </aside>
      </aside>
    </div>

    <button
      class="right-panel-btn"
      id="right-panel-btn"
      aria-label="Open support and Codeberg panel"
      aria-expanded="false"
      aria-controls="right-panel"
    >
      <svg
        role="img"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        focusable="false"
      >
        <title>Support and Codeberg</title>
        <polyline points="7 8 3 12 7 16"></polyline>
        <polyline points="17 8 21 12 17 16"></polyline>
        <line x1="14" y1="4" x2="10" y2="20"></line>
      </svg>
    </button>

    <script>
      const hamburger = document.getElementById("hamburger")!;
      const sidebar = document.getElementById("sidebar")!;
      const overlay = document.getElementById("sidebar-overlay")!;
      const toggle = document.getElementById("theme-toggle")!;
      const cbToggle = document.getElementById("cb-toggle")!;
      const cbPanel = document.getElementById("cb-panel")!;
      const cbClose = document.getElementById("cb-close")!;
      const cbBody = document.getElementById("cb-body")!;
      const sponsorPanel = document.getElementById("support-panel")!;

      function trapFocus(e: KeyboardEvent) {
        const focusable = Array.from(
          sidebar.querySelectorAll(
            "button, a, [tabindex]:not([tabindex='-1'])",
          ),
        ) as HTMLElement[];
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.key === "Tab") {
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }

      function openMenu() {
        sidebar.classList.add("is-open");
        overlay.classList.add("is-open");
        hamburger.setAttribute("aria-expanded", "true");
        hamburger.setAttribute("aria-label", "Close navigation menu");
        document.body.style.overflow = "hidden";
        const firstFocusable = sidebar.querySelector(
          "button, a",
        ) as HTMLElement;
        firstFocusable?.focus();
        sidebar.addEventListener("keydown", trapFocus);
      }

      function closeMenu() {
        sidebar.classList.remove("is-open");
        overlay.classList.remove("is-open");
        hamburger.setAttribute("aria-expanded", "false");
        hamburger.setAttribute("aria-label", "Open navigation menu");
        document.body.style.overflow = "";
        sidebar.removeEventListener("keydown", trapFocus);
        hamburger.focus();
      }

      hamburger.addEventListener("click", () => {
        sidebar.classList.contains("is-open") ? closeMenu() : openMenu();
      });

      overlay.addEventListener("click", closeMenu);

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeMenu();
          closeCB();
        }
      });

      function applyTheme(theme: string) {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("theme", theme);
        toggle.setAttribute(
          "aria-label",
          theme === "dark" ? "Switch to light mode" : "Switch to dark mode",
        );
      }

      toggle.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme");
        applyTheme(current === "dark" ? "light" : "dark");
      });

      const storedTheme = localStorage.getItem("theme");
      if (storedTheme) {
        toggle.setAttribute(
          "aria-label",
          storedTheme === "dark"
            ? "Switch to light mode"
            : "Switch to dark mode",
        );
      }

      let cbLoaded = false;

      async function loadCodeberg() {
        if (cbLoaded) return;
        cbLoaded = true;
        try {
          const base = "https://codeberg.org/api/v1";
          const [profileRes, reposRes, feedRes] = await Promise.all([
            fetch(`${base}/users/colabottles`),
            fetch(`${base}/users/colabottles/repos?limit=5`),
            fetch(`${base}/users/colabottles/activities/feeds?limit=8`),
          ]);

          const profile = await profileRes.json();
          const repos = await reposRes.json();
          const events = await feedRes.json();

          const typeMap: Record<string, string> = {
            create_repo: "created",
            rename_repo: "renamed",
            commit_repo: "pushed to",
            create_issue: "opened issue on",
            close_issue: "closed issue on",
            reopen_issue: "reopened issue on",
            comment_issue: "commented on",
            create_pull_request: "opened PR on",
            merge_pull_request: "merged PR on",
            transfer_repo: "transferred",
            fork_repo: "forked",
            mirror_sync_push: "synced",
          };

          cbBody.innerHTML = `
            <section class="cb-section" aria-labelledby="cb-profile-heading">
              <h3 id="cb-profile-heading" class="cb-section__title">profile</h3>
              <dl class="cb-profile">
                <div class="cb-profile__row"><dt>followers</dt><dd>${profile.followers_count ?? 0}</dd></div>
                <div class="cb-profile__row"><dt>following</dt><dd>${profile.following_count ?? 0}</dd></div>
                <div class="cb-profile__row"><dt>public repos</dt><dd>${Array.isArray(repos) ? repos.length : 0}</dd></div>
                <div class="cb-profile__row"><dt>member since</dt><dd>${profile.created ? new Date(profile.created).getFullYear() : "—"}</dd></div>
              </dl>
            </section>
            <section class="cb-section" aria-labelledby="cb-repos-heading">
              <h3 id="cb-repos-heading" class="cb-section__title">recent repos</h3>
              <ul class="cb-repos">
                ${(Array.isArray(repos) ? repos : [])
                  .map(
                    (r: any) => `
                  <li class="cb-repo">
                    <a href="${r.html_url}" class="cb-repo__name" target="_blank" rel="noopener noreferrer">${r.name}</a>
                    ${r.description ? `<p class="cb-repo__desc">${r.description}</p>` : ""}
                    <p class="cb-repo__meta">
                      ${r.language ? `<span class="cb-repo__lang">${r.language}</span>` : ""}
                      <span class="cb-repo__stars">&#9733; ${r.stars_count ?? 0}</span>
                    </p>
                  </li>
                `,
                  )
                  .join("")}
              </ul>
            </section>
            <section class="cb-section" aria-labelledby="cb-activity-heading">
              <h3 id="cb-activity-heading" class="cb-section__title">recent activity</h3>
              <ul class="cb-events">
                ${(Array.isArray(events) ? events : [])
                  .slice(0, 8)
                  .map((e: any) => {
                    const action = typeMap[e.op_type] ?? e.op_type ?? "activity on";
                    const repo = e.repo?.name ?? "a repo";
                    const branch = e.ref_name ? ` (${e.ref_name})` : "";
                    return `<li class="cb-event"><span class="cb-event__action">${action}</span> <span class="cb-event__repo">${repo}${branch}</span></li>`;
                  })
                  .join("")}
              </ul>
            </section>
          `;
        } catch {
          cbBody.innerHTML = `<p class="cb-error">Could not load Codeberg data.</p>`;
        }
      }

      function openCB() {
        cbPanel.classList.add("is-open");
        cbPanel.removeAttribute("aria-hidden");
        sponsorPanel.setAttribute("aria-hidden", "true");
        sponsorPanel.classList.add("is-hidden");
        cbToggle.setAttribute("aria-expanded", "true");
        cbToggle.setAttribute("aria-label", "Close Codeberg panel");
        loadCodeberg();
      }

      function closeCB() {
        cbPanel.classList.remove("is-open");
        cbPanel.setAttribute("aria-hidden", "true");
        sponsorPanel.removeAttribute("aria-hidden");
        sponsorPanel.classList.remove("is-hidden");
        cbToggle.setAttribute("aria-expanded", "false");
        cbToggle.setAttribute("aria-label", "Open Codeberg panel");
      }

      cbToggle.addEventListener("click", () => {
        cbPanel.classList.contains("is-open") ? closeCB() : openCB();
      });

      cbClose.addEventListener("click", closeCB);

      const rightPanelBtn = document.getElementById("right-panel-btn");
      const rightPanel = document.getElementById("right-panel");

      if (rightPanelBtn && rightPanel) {
        rightPanelBtn.addEventListener("click", () => {
          const isOpen = rightPanel.classList.contains("mobile-open");
          rightPanel.classList.toggle("mobile-open");
          rightPanelBtn.setAttribute(
            "aria-expanded",
            isOpen ? "false" : "true",
          );
          if (!isOpen) {
            document.body.style.overflow = "hidden";
          } else {
            document.body.style.overflow = "";
          }
        });
      }

      // Fetch Bluesky likes for recent posts
      const likeEls = document.querySelectorAll("[data-bsky-id]");
      if (likeEls.length > 0) {
        const myDid = "did:plc:gevyqibw5p2xsonkbsbjm5vy";
        for (const el of likeEls) {
          const id = el.getAttribute("data-bsky-id");
          if (!id) continue;
          try {
            const res = await fetch(
              `https://public.api.bsky.app/xrpc/app.bsky.feed.getPosts?uris=at://${myDid}/app.bsky.feed.post/${id}`,
            );
            const data = await res.json();
            const count = data.posts?.[0]?.likeCount ?? 0;
            el.textContent = `🦋 ${count}`;
          } catch {
            el.textContent = "";
          }
        }
      }
    </script>
  </body>
</html>