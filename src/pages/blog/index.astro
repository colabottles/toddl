---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sorted = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const tags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))];
---

<Base title="Blog" description="Writing on accessibility, development, and everything in between.">
  <section aria-labelledby="blog-heading">
    <h1 id="blog-heading" class="cmd-heading">
      <span class="cmd-prompt">$</span> ls ./blog
    </h1>

    <dl class="info-list">
      <div class="info-group">
        <dt class="info-group__label">total posts</dt>
        <dd class="info-group__content">{posts.length}</dd>
      </div>

      {
        tags.length > 0 && (
          <div class="info-group">
            <dt class="info-group__label">tags</dt>
            <dd class="info-group__content">
              <details class="tag-details">
                <summary class="tag-summary">{tags.length} tags</summary>
                <ul class="tag-list">
                  {tags.map((tag) => (
                    <li>
                      <span class="tag">{tag}</span>
                    </li>
                  ))}
                </ul>
              </details>
            </dd>
          </div>
        )
      }

      <div class="info-group">
        <dt class="info-group__label">feed</dt>
        <dd class="info-group__content">
          <a href="/rss.xml" class="info-link">./rss.xml</a>
        </dd>
      </div>
    </dl>

    <ol class="post-list" reversed aria-label="Blog posts">
      {
        sorted.map((post) => (
          <li class="post-item">
            <a href={`/blog/${post.id}`} class="post-link">
              <span class="post-meta">
                <time
                  datetime={new Date(post.data.date).toISOString()}
                  class="post-date"
                >
                  {new Date(post.data.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                {post.data.tags?.map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </span>
              <span class="post-title">{post.data.title}</span>
              {post.data.description && (
                <span class="post-excerpt">{post.data.description}</span>
              )}
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .info-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .info-group {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border: 0.5px solid var(--warm-border);
    border-radius: var(--radius-sm);
    background: var(--warm-mid);
    align-items: start;
  }

  .info-group__label {
    font-size: 0.75rem;
    color: var(--accent);
    padding-top: 0.125rem;
  }

  .info-group__content {
    font-size: 0.875rem;
    color: var(--text-primary);
    line-height: 1.7;
  }

  .info-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .info-link:hover {
    opacity: 0.8;
  }

  .tag-details {
    display: inline-block;
  }

  .tag-summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    width: fit-content;
  }

  .tag-summary::marker {
    color: var(--accent);
  }

  .tag-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .tag-details[open] .tag-summary {
    margin-bottom: 0.75rem;
  }

  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--warm-mid);
    border: 0.5px solid var(--warm-border);
    padding: 0.125rem 0.5rem;
    border-radius: 3px;
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-item {
    border-bottom: 0.5px solid var(--warm-border);
  }

  .post-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 0;
    text-decoration: none;
    color: inherit;
    transition: padding-left 0.15s;
  }

  .post-link:hover {
    padding-left: 0.5rem;
  }

  .post-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .post-title {
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .post-excerpt {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>